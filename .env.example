# ---- Local development (SQLite) ----
# DATABASE_URL="file:./dev.db"

# ---- Production (Postgres: Neon / Supabase / Vercel Postgres) ----
# Use the pooled connection string from your provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js session secret — generate with:  npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# For `npm run seed:admin` — creates ONE admin (instead of the demo accounts).
ADMIN_EMAIL="you@company.com"
ADMIN_PASSWORD="change-me-strong-password"

# Password reset mail, sent with Resend. Leave RESEND_API_KEY empty to dry-run (nothing is sent).
# MAIL_FROM is the sender, for example a verified address on your domain.
# APP_URL is this app's public origin, used to build the link. AUTH_URL is the fallback.
RESEND_API_KEY=
MAIL_FROM=
APP_URL=
